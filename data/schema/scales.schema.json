{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sv-rs/scales.schema.json",
  "title": "Biblioteca de escalas",
  "type": "object",
  "required": ["version", "families", "scales"],
  "properties": {
    "version": { "type": "string" },
    "notes": { "type": "string" },
    "families": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } }, "additionalProperties": false } },
    "scales": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "family", "intervals", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "family": { "type": "string" },
          "intervals": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "integer", "minimum": 0, "maximum": 11 } },
          "cents": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1200 } },
          "approx_rule": { "type": "string" },
          "status": { "enum": ["H", "I", "Hip", "V", "C"] },
          "verify": { "type": "boolean" },
          "verify_notes": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "random_rules": { "type": "object" }
  }
}

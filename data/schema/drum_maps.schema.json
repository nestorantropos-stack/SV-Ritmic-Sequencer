{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sv-rs/drum_maps.schema.json",
  "title": "Mapas de percusión",
  "type": "object",
  "required": ["version", "maps", "destination_defaults"],
  "properties": {
    "version": { "type": "string" },
    "notes": { "type": "string" },
    "maps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "tradition"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "tradition": { "type": "string" },
          "by_timbre": { "type": "boolean" },
          "roles": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 127 } },
          "timbre": { "type": "object", "propertyNames": { "enum": ["0", "1", "2", "3"] }, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 127 } },
          "labels": { "type": "object" },
          "verify": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "anyOf": [ { "required": ["roles"] }, { "required": ["timbre"] } ]
      }
    },
    "destination_defaults": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}

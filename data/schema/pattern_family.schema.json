{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sv-rs/pattern_family.schema.json",
  "title": "Familia de patrones rítmicos (SV Ritmic Sequencer)",
  "type": "object",
  "required": ["family", "name", "patterns"],
  "additionalProperties": false,
  "properties": {
    "family": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name": { "type": "string" },
    "notes": { "type": "string" },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "note": { "type": "string" }, "ratio": { "type": "string" }, "status": { "$ref": "#/definitions/status" } },
        "additionalProperties": false
      }
    },
    "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pattern" } }
  },
  "definitions": {
    "status": { "enum": ["H", "I", "Hip", "V", "C"] },
    "taxonomyId": { "type": "string", "pattern": "^[A-Z]{3}(\\.[0-9]+[a-z]?)*$" },
    "numArray": { "type": "array", "items": { "type": "number" } },
    "intArray": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "origin": {
      "type": "object",
      "required": ["tradition", "sources"],
      "additionalProperties": false,
      "properties": {
        "tradition": { "type": "string", "minLength": 1 },
        "genre": { "type": "array", "items": { "type": "string" } },
        "context": { "type": "string" },
        "attributions": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "restricted_use": { "type": "boolean" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["role", "onsets"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "onsets": { "$ref": "#/definitions/intArray" },
        "cycle_len": { "type": "integer", "minimum": 1 },
        "velocity": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 127 } },
        "timbre": { "type": "array", "items": { "enum": [0, 1, 2, 3] } },
        "microtiming": { "type": "array", "items": { "type": "number", "minimum": -0.5, "maximum": 0.5 } },
        "gate": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "probability": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "swing": { "type": "number", "minimum": 1, "maximum": 3 },
        "notes": { "type": "string" }
      }
    },
    "generator": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["euclid", "carnatic_tala", "polyrhythm", "weighted_steps", "aksak"] }
      }
    },
    "repeatPolicy": {
      "type": "object",
      "required": ["mode", "default_repeats"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["fixed", "cycles", "lcm", "tihai", "gongan"] },
        "default_repeats": { "type": "integer", "minimum": 1, "maximum": 64 },
        "variation_on_last": { "enum": ["none", "fill", "hat_triplet_fill", "trap_roll", "tihai", "gong", "llamada", "virada", "dropout", "density_up"] },
        "max_bars": { "type": "integer", "minimum": 1 }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["id", "name", "taxonomy", "origin", "status", "verify", "step_value", "meter", "layers", "transforms_allowed", "destinations", "categories", "repeat_policy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{3}(\\.[0-9]+[a-z]?)*/[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "taxonomy": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/taxonomyId" } },
        "origin": { "$ref": "#/definitions/origin" },
        "status": { "$ref": "#/definitions/status" },
        "verify": { "type": "boolean" },
        "verify_notes": { "type": "string" },
        "missing_data": { "type": "boolean" },
        "restricted_use": { "type": "boolean" },
        "structural_only": { "type": "boolean" },
        "cultural_note": { "type": "string" },
        "cycle_len": { "type": "integer", "minimum": 1, "maximum": 256 },
        "step_value": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
        "meter": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
        "grouping": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "meter_weights": { "oneOf": [ { "const": "auto" }, { "$ref": "#/definitions/numArray" } ] },
        "layers": { "type": "array", "items": { "$ref": "#/definitions/layer" } },
        "generator": { "$ref": "#/definitions/generator" },
        "transforms_allowed": { "type": "array", "items": { "enum": ["rotate", "reverse", "complement", "density", "swing", "phase", "binarize"] } },
        "destinations": { "type": "array", "minItems": 1, "items": { "enum": ["bassline", "chords", "arpeggio", "hihats", "ethnic", "others"] } },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bpm_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "bpm_range_verify": { "type": "boolean" },
        "corpus": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "object" },
        "fx": { "type": "object" },
        "repeat_policy": { "$ref": "#/definitions/repeatPolicy" },
        "notes": { "type": "string" }
      }
    }
  }
}
